# loomy2api 运行时配置（UTF-8 无 BOM；只用 ASCII 可见字符）
# 复制为 .env 后按需修改；uv 用 --env-file .env 加载。

LOOMY2API_BIND=127.0.0.1
LOOMY2API_PORT=8788

# 管理与推理密钥；留空则首次启动自动生成并保存到 control.sqlite3
LOOMY2API_KEY=

# Loomy 上游（讯飞）；一般不用改
LOOMY2API_UPSTREAM=https://loomyad.xunfei.cn/api/v1

# Loomy 会话文件；留空自动推导为 C:\Users\Public\Loomy\<用户哈希>\userData\auth-session.json
LOOMY2API_SESSION_PATH=

# 数据目录；留空默认 loomy2api/data
LOOMY2API_DATA_DIR=

# 管理页 Origin/CSRF 校验；仅受信任本地环境可设 false
LOOMY2API_ADMIN_CSRF=true

# 表外模型拦截
LOOMY2API_MODEL_GUARD=true

LOOMY2API_MAX_REQUEST_BYTES=33554432
LOOMY2API_MAX_INBOUND_BYTES=67108864
LOOMY2API_MAX_CONCURRENT=64
